---
import { getCollection, getEntry } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { localUrl } from "../data/links";

const siteEntry = await getEntry("site", "settings");
if (!siteEntry) throw new Error("Dados do portfólio não encontrados.");
const site = siteEntry.data;

const projects = (await getCollection("projects", ({ data }) => data.published))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);
const services = (await getCollection("services", ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
const featuredServices = ["web", "design", "analytics"]
  .map((category) => services.find((service) => service.data.category === category))
  .filter((service) => service !== undefined);
const serviceLabels: Record<string, string> = {
  web: "Web",
  design: "Design",
  analytics: "Dados",
  maintenance: "Manutenção",
};
---

<SiteLayout
  title="Início"
  description={site.seo_description}
  currentPage="home"
>
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{site.tagline}</p>
      <h1>{site.name}<span class="hero-mark">.</span></h1>
      <p class="hero-headline">{site.headline}</p>
      <p class="hero-intro">{site.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={localUrl(projects.length ? "projects.html" : "services.html")}>
          {projects.length ? "Explorar projetos" : "Conhecer serviços"} <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={`mailto:${site.email}`}>Vamos conversar <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-socials" aria-label="Perfis profissionais">
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-art-orbit"></div>
      <img
        src={localUrl("assets/images/logo_portfolio.png")}
        alt=""
        width="512"
        height="512"
        fetchpriority="high"
      />
      <span class="hero-art-caption">CRIAÇÃO COM INTENÇÃO</span>
    </div>
    <a class="hero-scroll" href="#trabalhos"><span></span> Deslize para explorar</a>
  </section>

  {
    projects.length ? (
      <section id="trabalhos" class="section-shell section-block">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / TRABALHOS</p>
            <h2>Feito para <span>fazer sentido.</span></h2>
          </div>
          <a class="text-link" href={localUrl("projects.html")}>Todos os projetos <span aria-hidden="true">→</span></a>
        </div>
        <div class="project-grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    ) : (
      <section id="trabalhos" class="section-shell section-block">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / SERVIÇOS</p>
            <h2>O que posso criar<br /><span>com você.</span></h2>
          </div>
          <a class="text-link" href={localUrl("services.html")}>Ver todos os serviços <span aria-hidden="true">→</span></a>
        </div>
        {featuredServices.length > 0 ? (
          <div class="service-list">
            {featuredServices.map((service) => (
              <article class="service-row">
                <span class="service-category">{serviceLabels[service.data.category]}</span>
                <div class="service-copy"><h2>{service.data.title}</h2><p>{service.data.description}</p></div>
                <span class="service-price">{service.data.price}</span>
                <a class="service-arrow" href={localUrl("contact.html")} aria-label={`Conversar sobre ${service.data.title}`}>↗</a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state"><p>Estou preparando esta página. Enquanto isso, entre em contato para conversar sobre o que você precisa.</p></div>
        )}
      </section>
    )
  }

  <section class="manifesto-band">
    <div class="section-shell manifesto-inner">
      <p class="eyebrow">MENOS RUÍDO. MAIS SIGNIFICADO.</p>
      <p>Boas soluções digitais começam com <em>escuta</em> e terminam com algo que <em>funciona de verdade.</em></p>
    </div>
  </section>

  <section class="section-shell closing-cta">
    <p class="eyebrow">TEM UMA IDEIA?</p>
    <h2>Vamos dar forma<br />ao que vem <span>a seguir.</span></h2>
    <a class="button button-primary" href={localUrl("contact.html")}>Fale comigo <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
