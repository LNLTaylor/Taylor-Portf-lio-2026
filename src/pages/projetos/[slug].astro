---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { localUrl, mediaUrl } from "../../data/links";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.published);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const cover = mediaUrl(data.cover);
const technologies = data.technologies?.split(",").map((item) => item.trim()).filter(Boolean) ?? [];
---

<SiteLayout title={data.title} description={data.summary} currentPage="projects">
  <article class="case-study section-shell">
    <a class="text-link case-back" href={localUrl("projects.html")}>← Todos os projetos</a>
    <header class="case-header">
      <p class="eyebrow">{data.category}{data.year ? ` / ${data.year}` : ""}</p>
      <h1>{data.title}<span>.</span></h1>
      <p class="page-lede">{data.summary}</p>
      {data.role && <p class="case-role"><strong>Meu papel:</strong> {data.role}</p>}
    </header>
    {cover && <img class="case-cover" src={cover} alt={data.cover_alt || data.title} width="1600" height="1000" fetchpriority="high" />}
    <div class="case-content">
      {data.challenge && <section><p class="eyebrow">CONTEXTO</p><h2>O desafio</h2><p>{data.challenge}</p></section>}
      {data.decisions && <section><p class="eyebrow">PROCESSO</p><h2>As escolhas</h2><p>{data.decisions}</p></section>}
      {data.outcome && <section><p class="eyebrow">RESULTADO</p><h2>O que ficou</h2><p>{data.outcome}</p></section>}
      {technologies.length > 0 && <section><p class="eyebrow">FERRAMENTAS</p><ul class="technology-list">{technologies.map((technology) => <li>{technology}</li>)}</ul></section>}
    </div>
    <div class="case-actions">
      {data.live_url && <a class="button button-primary" href={data.live_url} target="_blank" rel="noopener noreferrer">Ver projeto <span aria-hidden="true">↗</span></a>}
      {data.source_url && <a class="text-link" href={data.source_url} target="_blank" rel="noopener noreferrer">Ver código <span aria-hidden="true">↗</span></a>}
    </div>
  </article>
</SiteLayout>
